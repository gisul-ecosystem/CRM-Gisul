#!/usr/bin/env sh

set -eu

[ -n "${CRM_SKIP_HOOKS:-}" ] && exit 0

deleting_only=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	case "$local_sha" in
	0000000000000000000000000000000000000000) ;;
	*) deleting_only=0 ;;
	esac
done
[ "$deleting_only" = "1" ] && exit 0

fail() {
	echo ""
	echo "  \`bun run $1\` failed, so this push would have failed CI."
	echo "  Fix it, or push anyway with --no-verify."
	echo ""
	exit 1
}

resolve_bun() {
	if [ -n "${BUN:-}" ] && [ -x "$BUN" ]; then
		printf '%s\n' "$BUN"
		return 0
	fi
	if command -v bun >/dev/null 2>&1; then
		command -v bun
		return 0
	fi
	root="$(git rev-parse --show-toplevel)"
	for candidate in "$root/.tools/bun/bun" "$root/.tools/bun/bun.exe"; do
		if [ -x "$candidate" ]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	return 1
}

bun_bin="$(resolve_bun)" || {
	echo ""
	echo "  bun is not on PATH and was not found at .tools/bun/."
	echo "  Install bun, set BUN to its path, or add .tools/bun to PATH."
	echo ""
	exit 1
}

for task in check-types lint lint:slop test; do
	echo "pre-push: bun run $task"
	"$bun_bin" run "$task" || fail "$task"
done
