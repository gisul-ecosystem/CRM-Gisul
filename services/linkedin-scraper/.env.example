# Server
PORT=6363

# Local MongoDB (host). Docker Compose overrides to mongodb://mongo:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=linkedin_scrapper
# Optional — hourly local→Atlas backup. Off unless this is set.
# MONGODB_ATLAS_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# ATLAS_BACKUP_MS=3600000

# Browser
HEADLESS=false
ACTION_DELAY_MS=3000

# AI — Claude preferred (put real key only in .env — never commit it)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=2000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MESSAGES=true

# RAG (knowledge/*.md) — index TTL 1 day
RAG_TTL_MS=86400000
RAG_TOP_K=4
# Model relevanceScore gate (0–100), not RAG cosine. Legacy alias: RAG_MIN_SCORE
AI_CONFIDENCE_MIN_SCORE=60

# Messaging pacing (LinkedIn safety)
DAILY_SEND_LIMIT=60
SEND_BATCH_SIZE=20
SEND_BATCH_PAUSE_MS=600000
SEND_DAY_TZ=Asia/Kolkata

# Post search runs per day (LinkedIn safety). Each run reads at most 25 posts,
# with random pauses. Raise it only for an older account. Counted per SEND_DAY_TZ day.
POST_SEARCH_DAILY_RUNS=1

# Company search runs per day (LinkedIn safety). Each run opens at most 40 company
# pages, 20 to 45 seconds apart. Counted per SEND_DAY_TZ day.
COMPANY_SEARCH_DAILY_RUNS=2

# How many CRM users can run LinkedIn browser jobs at the same time (1 to 6).
# Each one gets its own screen, Chromium and private viewer. Each running
# Chromium needs about 500 MB of memory.
LINKEDIN_BROWSER_SLOTS=3

# Messaging is AI + queue from the UI (SEND_MESSAGES kept false)
SEND_MESSAGES=false
