# Gaming leads (profile "gaming"): esports and tournament organisers, gaming communities and game jams,
# gaming cafes and LAN centres, game studios, cloud gaming and Pixel Streaming companies, VR and
# metaverse apps, AI-in-gaming companies and game dev academies: everyone who needs GPUs.
# Copy to .env.gaming (or use the CRM's "Gaming leads" tab, which writes this file).
# Only filters and limits live here. Connection settings (USER_AGENT, REACHER_URL, SERPER_API_KEY...)
# are shared and come from .env. Nothing here affects the other profiles.
# Data: data/gaming/ (sheet, day sheets, state, log); override with GAMING_DATA_DIR.

INDIA_ONLY=1
COUNTRIES=India,Malaysia,Singapore,Thailand,Indonesia
# 1 = drop companies whose site shows no gaming segment (seed lists are always kept)
REQUIRE_SEGMENT=1
# Usually 0: tournament organisers, cafes and studios of any age need GPUs
EARLY_ONLY=0
MAX_TEAM_SIZE=100000

# Segments to collect (comma list; empty = all):
#   esports, gaming_community, gaming_cafe, game_studio, cloud_gaming, gaming_xr, gaming_ai, game_academy
SEGMENTS=
# Sources to leave out: seeds, search, maps, funding, github
SKIP_SOURCES=

# Web searches and Google Maps searches need SERPER_API_KEY (or Tavily / Brave) in .env
SEARCH_DISCOVERY_PER_RUN=60
MAPS_PER_RUN=60
BATCH_SIZE=200
ROUND_SIZE=200
WORKERS=6
DOMAIN_DELAY=1.5
MIN_SCORE=5
MAX_PEOPLE=5
RENDER_JS=1
RUN_AT=
