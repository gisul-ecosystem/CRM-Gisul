# Competitor-cloud leads (profile "competitors"): clients actively renting from competitor clouds
# (E2E Networks, Neysa, Jarvis Labs, AIC Cloud, Yotta, RunPod, Lambda Labs, CoreWeave, etc.).
# Copy to .env.competitors (or use the web page's "Competitor clients" tab, which writes this file).
# Only filters and limits live here. Connection settings (USER_AGENT, REACHER_URL, BRAVE_API_KEY...)
# are shared and come from .env. Nothing here affects the GPU leads or Training-lab leads.
# Data: data/competitors/ (sheet, day sheets, state, log); override with COMPETITORS_DATA_DIR.

INDIA_ONLY=1
# 1 = drop companies whose site shows no cloud/GPU or competitor usage (seed lists are always kept)
REQUIRE_SEGMENT=1
# Usually 0: companies of any age that rent GPUs from competitors are prime prospects for Racko
EARLY_ONLY=0
MAX_TEAM_SIZE=100000

# Segments to collect (comma list; empty = all):
#   competitor_clients, ai, vfx_animation, gaming, xr_3d
SEGMENTS=
# Sources to leave out: competitors, seeds, search
SKIP_SOURCES=

BATCH_SIZE=200
ROUND_SIZE=200
WORKERS=6
DOMAIN_DELAY=1.5
MIN_SCORE=5
MAX_PEOPLE=5
RENDER_JS=1
RUN_AT=

