# Training-lab leads (profile "training"): organisations that need VMs for training labs and courses.
# Copy to .env.training (or use the web page's "Training-lab leads" tab, which writes this file).
# Only filters and limits live here. Connection settings (USER_AGENT, GITHUB_TOKEN, REACHER_URL,
# BRAVE_API_KEY...) are shared and come from .env. Nothing here affects the GPU leads.
# Data: data/training/ (sheet, day sheets, state, log); override with TRAINING_DATA_DIR.

# Only organisations in COUNTRIES: always on for this profile (INDIA_ONLY is ignored here).
# Any of India, Malaysia, Singapore, Thailand, Indonesia.
COUNTRIES=India,Malaysia,Singapore,Thailand,Indonesia
# 1 = drop organisations whose site shows no training activity (seed lists are always kept)
REQUIRE_SEGMENT=1
# 1 = small & medium organisations only: drops sites showing 50k+ learners, 10+ branches,
#     300+ staff or a stock-market listing
SMALL_ONLY=1
# Usually 0: institutes and universities of any age need lab VMs
EARLY_ONLY=0
MAX_TEAM_SIZE=100000

# Kinds of organisation to collect (comma list; empty = all):
#   upskilling, training_institute, university, corporate_training
SEGMENTS=
# Sources to leave out: seeds, directories, search, funding, github
SKIP_SOURCES=

BATCH_SIZE=200
ROUND_SIZE=200
WORKERS=6
DOMAIN_DELAY=1.5
MIN_SCORE=5
MAX_PEOPLE=5
# Web searches for new institutes per run ("<course> training institute in <city>").
# Needs BRAVE_API_KEY in .env; Brave's $5 monthly credit covers ~1,000 searches.
SEARCH_DISCOVERY_PER_RUN=60
SEARCH_MAX_PER_RUN=0
RENDER_JS=1
# Daily run time when the web page schedules runs (Docker). On a plain server cron runs it at 04:00.
RUN_AT=
# Google Maps searches per run (Serper Places, 1 credit each; needs SERPER_API_KEY in .env)
MAPS_PER_RUN=60
