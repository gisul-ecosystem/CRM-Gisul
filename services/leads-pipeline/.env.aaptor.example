# Aaptor leads (profile "aaptor"): companies that hire tech people at volume or assess their staff:
# IT services firms, GCCs, staffing and RPO firms, SaaS companies, college placement cells, bootcamps.
# Copy to .env.aaptor (or use the CRM's "Aaptor leads" tab, which writes this file).
# Only filters and limits live here. Connection settings (USER_AGENT, REACHER_URL, SERPER_API_KEY...)
# are shared and come from .env. Nothing here affects the other profiles.
# Data: data/aaptor/ (sheet, day sheets, state, log); override with AAPTOR_DATA_DIR.

INDIA_ONLY=1
COUNTRIES=India,Malaysia,Singapore,Thailand,Indonesia
# 1 = drop organisations whose site shows no matching segment (seed lists are always kept)
REQUIRE_SEGMENT=1
# Usually 0: companies and colleges of any age hire and train
EARLY_ONLY=0
MAX_TEAM_SIZE=100000

# Segments to collect (comma list; empty = all):
#   it_services, gcc, staffing, product_company, campus, edtech, workforce, competitor_clients
SEGMENTS=
# Sources to leave out: seeds, competitors, directories, search, maps, funding
SKIP_SOURCES=

# Web searches and Google Maps searches need SERPER_API_KEY (or Tavily / Brave) in .env
SEARCH_DISCOVERY_PER_RUN=60
MAPS_PER_RUN=60
BATCH_SIZE=200
ROUND_SIZE=200
WORKERS=6
DOMAIN_DELAY=1.5
MIN_SCORE=5
MAX_PEOPLE=5
RENDER_JS=1
RUN_AT=
