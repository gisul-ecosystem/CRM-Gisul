# KanonKode leads (profile "kanonkode"): companies that must upskill tech teams, and colleges that need industry training:
# IT services firms, GCCs, tech companies, enterprises going digital, L&D teams, colleges, skilling missions.
# Copy to .env.kanonkode (or use the CRM's "KanonKode leads" tab, which writes this file).
# Only filters and limits live here. Connection settings (USER_AGENT, REACHER_URL, SERPER_API_KEY...)
# are shared and come from .env. Nothing here affects the other profiles.
# Data: data/kanonkode/ (sheet, day sheets, state, log); override with KANONKODE_DATA_DIR.

INDIA_ONLY=1
COUNTRIES=India,Malaysia,Singapore,Thailand,Indonesia
# 1 = drop organisations whose site shows no matching segment (seed lists are always kept)
REQUIRE_SEGMENT=1
# Usually 0: companies and colleges of any age hire and train
EARLY_ONLY=0
MAX_TEAM_SIZE=100000

# Segments to collect (comma list; empty = all):
#   it_services, gcc, tech_company, enterprise, college, learning_team, skilling, competitor_clients
SEGMENTS=
# Sources to leave out: seeds, competitors, directories, search, maps, funding
SKIP_SOURCES=

# Web searches and Google Maps searches need SERPER_API_KEY (or Tavily / Brave) in .env
SEARCH_DISCOVERY_PER_RUN=60
MAPS_PER_RUN=60
BATCH_SIZE=200
ROUND_SIZE=200
WORKERS=6
DOMAIN_DELAY=1.5
MIN_SCORE=5
MAX_PEOPLE=5
RENDER_JS=1
RUN_AT=
