# Copy to .env and fill in. All values are optional except where noted.

# Where leads.xlsx, state.json, backups/ and the lock file live
DATA_DIR=./data

# Strongly recommended: raises GitHub API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
# Optional: Hugging Face token (higher rate limits)
HF_TOKEN=

# Identify your bot politely. Put a real contact address here.
USER_AGENT=GPULeadBot/1.0 (+mailto:you@yourdomain.com)

# Default country for parsing phone numbers without a + prefix
DEFAULT_REGION=IN

# Max companies handled per run (keeps each run bounded)
BATCH_SIZE=200
# The run goes in rounds of this many companies; each round goes through every step (site, people,
# emails, check) and is added to today's day sheet before the next round starts.
ROUND_SIZE=200
# Websites read at the same time. Each site still gets one request at a time with DOMAIN_DELAY
# between them; more workers just means more different sites in parallel. 1 = one by one.
WORKERS=6
# Seconds to wait between requests to the same website
DOMAIN_DELAY=3

# Reacher SMTP verifier. Leave empty to only do MX-record checks.
REACHER_URL=http://localhost:8080/v0/check_email
REACHER_SECRET=
# People search: when a company's website names nobody, look up its founders / CEO / CTO in public
# search results (site:linkedin.com/in "Company" founder OR CEO ...). LinkedIn itself is not opened.
# Key: api.search.brave.com, "Search" plan. It includes $5 of free credit a month (~1,000
# searches at $5 per 1,000) and needs a card; it is only charged above the credit. Empty = off.
BRAVE_API_KEY=
# Training-lab leads: web search for small institutes ("DevOps training institute in Pune").
# Free without a card: Serper (serper.dev, 2,500 searches once) or Tavily (tavily.com, 1,000 a month).
# The first key set is used: Serper, then Tavily, then Brave.
SERPER_API_KEY=
TAVILY_API_KEY=
# Searches per run; each company is searched once. 30/day (~930/month) stays inside the credit.
SEARCH_MAX_PER_RUN=30

# Max pattern candidates to probe per person
MAX_CANDIDATES=4

# Leads at or above this score get ready=yes
MIN_SCORE=5

# Optional: Slack/Discord-compatible webhook that is pinged if a run crashes
ALERT_WEBHOOK_URL=

# 1 = keep only companies in the COUNTRIES below (domain ending, phone code, company registration
#     such as Pvt Ltd / Sdn Bhd / Pte Ltd, address). 0 = worldwide.
INDIA_ONLY=1
# Target countries: any of India, Malaysia, Singapore, Thailand, Indonesia. Search and Maps cover
# their cities, taking turns between countries. Filter the sheet by country on the web page.
COUNTRIES=India,Malaysia,Singapore,Thailand,Indonesia

# 1 = keep only early-stage startups (pre-seed to pre-Series A). A company is dropped when any
#     evidence says it is past that: founded more than MAX_AGE_YEARS ago (CIN year, "founded in",
#     copyright years, YC batch, GitHub org age), a Series A or later round / listed, a large fund
#     named as investor or $5M+ raised on its own website, more than MAX_TEAM_SIZE people, or
#     listed in leads/established.txt.
EARLY_ONLY=1
MAX_AGE_YEARS=5
MAX_TEAM_SIZE=50
# Segments that skip the early-stage filter (studios rent GPUs at any age). "none" = no exemptions.
EARLY_EXEMPT_SEGMENTS=vfx_animation,gaming,arch_viz

# Decision makers kept per company (founders, CEO, CTO, heads of AI / infra ...)
MAX_PEOPLE=5

# Sources to leave out of the daily run (comma list), e.g. SKIP_SOURCES=github,hn
#   seeds, incubators, funding, github, huggingface, hn   (yc is already off)
SKIP_SOURCES=

# Which kinds of vGPU customer to look for (comma list; empty = all):
#   ai, vfx_animation, gaming, arch_viz, life_sciences, drones_robotics, video_analytics, quant, xr_3d
SEGMENTS=

# 1 = drop companies whose website shows none of the segments above (hand-made seed lists are
#     always kept). Matters most for incubator portfolios, which mix in fintech, D2C, etc.
REQUIRE_SEGMENT=1

# API for the CRM (python -m leads.web). It has no login: keep its port private.
WEB_HOST=127.0.0.1
WEB_PORT=8501
# Daily run time (HH:MM) started by the web page itself. Leave empty when cron runs the pipeline
# (setup_server.sh); Docker sets it to 02:00 because a container has no cron.
RUN_AT=

# 1 = when a page is built by JavaScript (almost no text in the plain HTML), load it in a
#     headless Chromium instead. Needs: playwright install chromium. 0 = never.
RENDER_JS=1

# Google Maps searches per run (Serper Places, 1 credit each; needs SERPER_API_KEY in .env)
MAPS_PER_RUN=40
